#!/bin/sh
# Shim for self-improvement-loop: resolves the plugin root, then execs `sil`
# inside it via bun. Installed to ~/.local/bin/sil by `sil schedule install`,
# so a plugin version bump never breaks an installed systemd/launchd unit
# (those call this fixed path, not one under a versioned plugin cache dir).
set -eu

resolve_root() {
  if [ -n "${SIL_PLUGIN_ROOT:-}" ]; then
    printf '%s\n' "$SIL_PLUGIN_ROOT"
    return 0
  fi

  installed="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json"
  if [ -f "$installed" ]; then
    runner=""
    if command -v bun >/dev/null 2>&1; then
      runner="bun"
    elif command -v node >/dev/null 2>&1; then
      runner="node"
    fi
    if [ -n "$runner" ]; then
      found="$("$runner" - "$installed" <<'JSEOF'
const fs = require("fs");
try {
  const data = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
  const entries = (data.plugins && data.plugins["self-improvement-loop@kolezka"]) || [];
  if (entries.length) {
    const newest = entries.reduce((a, b) => ((a.lastUpdated || "") >= (b.lastUpdated || "") ? a : b));
    if (newest.installPath) console.log(newest.installPath);
  }
} catch {
  // fall through to the two-dirs-up fallback below
}
JSEOF
)"
      if [ -n "$found" ]; then
        printf '%s\n' "$found"
        return 0
      fi
    fi
  fi

  # Fall back to two levels up from this script (scripts/sil -> plugin root).
  script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
  CDPATH= cd -- "$script_dir/.." && pwd
}

ROOT="$(resolve_root)"

if [ -f "$ROOT/dist/cli.js" ]; then
  exec bun "$ROOT/dist/cli.js" "$@"
fi

# Dev checkout with no build yet: run the CLI straight from source.
exec bun "$ROOT/apps/cli/src/main.ts" "$@"
