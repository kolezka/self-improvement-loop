{
  "description": "self-improvement-loop fast path. Every event runs dist/hook.js under bun and never blocks or calls a model; when Claude Code loads the hooks module (dist/hook-module.js), it owns SessionStart/UserPromptSubmit/PreToolUse/PostToolUse in process and the guarded commands below skip.",
  "modules": ["../dist/hook-module.js"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$SIL_HOOK_MODULE\" = \"$PPID\" ] || bun \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$SIL_HOOK_MODULE\" = \"$PPID\" ] || bun \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$SIL_HOOK_MODULE\" = \"$PPID\" ] || bun \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$SIL_HOOK_MODULE\" = \"$PPID\" ] || bun \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
