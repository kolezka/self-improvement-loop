{
  "name": "self-improvement-loop",
  "version": "1.2.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "install:local": "bun run build && bun run scripts/install-local.ts",
    "bench": "bun run scripts/bench.ts",
    "bench:hooks": "bun run scripts/bench-hooks.ts",
    "eval:alias-semantic": "bun run scripts/eval-alias-semantic.ts",
    "test": "bun test",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "check:web": "bun run --cwd apps/web check",
    "lint:dashes": "bun run scripts/lint-dashes.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "sil": "bun run apps/cli/src/main.ts",
    "demo:record": "bun run scripts/demo/record.ts",
    "test:changed": "bun run scripts/test-changed.ts"
  },
  "devDependencies": {
    "@sil/core": "workspace:*",
    "@sil/critic": "workspace:*",
    "@sil/curriculum": "workspace:*",
    "@sil/feedback": "workspace:*",
    "@sil/nudges": "workspace:*",
    "@sil/openclaw": "workspace:*",
    "@sil/ops": "workspace:*",
    "@sil/providers": "workspace:*",
    "@sil/review": "workspace:*",
    "@sil/store": "workspace:*",
    "@sil/transcript": "workspace:*",
    "@sil/worker": "workspace:*",
    "@types/bun": "^1.4.2",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.0"
  }
}
